# Copy to .env.local. Leave both empty and the app runs on a fake server kept in localStorage,
# where every tab is its own phone (add ?phone=ana to name one, ?offline to cut its signal).
# Set both to sync groups through Supabase, after running supabase/migrations/ on the project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
